<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.gnome-wallpaper-engine"
        path="/org/gnome/shell/extensions/gnome-wallpaper-engine/">
        <key name="autostart" type="b">
            <default>true</default>
            <summary>Autostart the wallpaper</summary>
        </key>
        <key name="show-indicator" type="b">
            <default>true</default>
            <summary>Show or hide the tray icon</summary>
        </key>
        <key name="play-audio" type="b">
            <default>true</default>
            <summary>Play audio when the wallpaper is active</summary>
        </key>
        <key name="pause-on-fullscreen" type="b">
            <default>true</default>
            <summary>Pause when a fullscreen application is active</summary>
        </key>

        <key name="pause-on-battery" type="b">
            <default>false</default>
            <summary>Pause when running on battery</summary>
        </key>
        <key name="current-wallpaper" type="s">
            <default>''</default>
            <summary>Der Pfad zum aktuellen Hintergrund</summary>
        </key>
        <key name="backgrounds-directory" type="s">
            <default>''</default>
            <summary>Path to the directory containing wallpapers</summary>
        </key>
        <key name="youtube-quality" type="s">
            <default>'HD'</default>
            <summary>YouTube video quality (SD,HD,UHD)</summary>
        </key>
        <key name="youtube-codex" type="s">
            <default>'h264'</default>
            <summary>YouTube video codec (av1,vp9,h264)</summary>
        </key>
        <key name="youtube-stream" type="b">
            <default>false</default>
            <summary>Stream YouTube (false = download)</summary>
        </key>
        <key name="thumb-time" type="s">
            <default>'00:00:10'</default>
            <summary>Timestamp for static background image</summary>
        </key>
    </schema>
</schemalist>
